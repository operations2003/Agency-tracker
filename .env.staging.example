# =================================================================
# AGENCY SLA AND MARGIN LEAKAGE TRACKER - STAGING CONFIGURATION
# =================================================================

NODE_ENV=staging
PORT=5000

# PostgreSQL Connection String for Staging Environment
DATABASE_URL=postgresql://staging_user:REPLACE_WITH_STAGING_PASSWORD@staging-db.internal.agency.com:5432/agency_tracker_staging?schema=public

# Authentication & Security
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://staging.agencytracker.com

# External Integrations (Staging testing channels)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/STAGING/WEBHOOK/PLACEHOLDER
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=REPLACE_WITH_MAILTRAP_USER
SMTP_PASS=REPLACE_WITH_MAILTRAP_PASSWORD
SMTP_FROM=staging-alerts@agencytracker.com

LOG_LEVEL=debug


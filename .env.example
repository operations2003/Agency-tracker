# Application Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=24h

# Database (PostgreSQL for Staging/Production, SQLite supported for embedded local dev)
# Staging/Production PostgreSQL example:
# DATABASE_URL=postgresql://agency_user:secure_password@localhost:5432/agency_tracker?schema=public
# Embedded SQLite example:
DATABASE_URL=file:./dev.db

# Alert & Notification Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=alerts@youragency.com

# Business Rule Warning Thresholds
DEFAULT_MARGIN_WARNING=20.0
DEFAULT_SLA_AMBER=70.0
DEFAULT_SLA_RED=90.0
DEFAULT_MAX_OPEN_ROLES=8
DEFAULT_MAX_WEEKLY_HOURS=45.0


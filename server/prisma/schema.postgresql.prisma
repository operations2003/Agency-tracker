datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MANAGER
  RECRUITER
  FINANCE
}

enum BillingModel {
  RETAINER
  HOURLY
  PER_HIRE
}

enum DeadlinePolicy {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum RoleStatus {
  OPEN
  ON_HOLD
  FILLED
  CANCELLED
}

enum PipelineStage {
  NEW_REQUEST
  SOURCING
  SCREENING
  SHORTLISTING
  SHORTLIST_SUBMITTED
  INTERVIEW
  OFFER
  HIRED_FILLED
  ON_HOLD
  CANCELLED
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum RecruiterCostType {
  HOURLY
  SALARIED
}

enum AlertType {
  AMBER_SLA
  RED_SLA
  LOW_MARGIN
  RECRUITER_OVERLOAD
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  systemSettings SystemSetting[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  email          String       @unique
  passwordHash   String       @map("password_hash")
  name           String
  role           UserRole     @default(RECRUITER)
  isActive       Boolean      @default(true) @map("is_active")
  title          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    UserClientAssignment[]
  timeEntries    TimeEntry[]  @relation("RecruiterEntries")
  reviewedEntries TimeEntry[] @relation("ReviewedEntries")
  costProfiles   RecruiterCostProfile[]
  assignedRoles  RecruitmentRole[] @relation("RecruiterAssignedRoles")
  managedRoles   RecruitmentRole[] @relation("ManagerAssignedRoles")
  resolvedAlerts Alert[]      @relation("AlertResolvedBy")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

model Client {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  code           String         @unique
  status         String         @default("ACTIVE")
  billingModel   BillingModel   @default(RETAINER) @map("billing_model")
  currency       String         @default("USD")
  timeZone       String         @default("America/New_York") @map("time_zone")
  marginWarningThreshold Decimal @default(20.0) @db.Decimal(5, 2) @map("margin_warning_threshold")
  deadlinePolicy DeadlinePolicy @default(WORKING_DAYS) @map("deadline_policy")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    UserClientAssignment[]
  contractTerms  ContractTerm[]
  slaPolicy      SlaPolicy?
  holidayCalendar HolidayCalendar?
  roles          RecruitmentRole[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  billableHires  BillableHire[]
  adjustments    FinancialAdjustment[]
  alerts         Alert[]

  @@index([organizationId])
  @@map("clients")
}

model UserClientAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_assignments")
}

model ContractTerm {
  id           String       @id @default(uuid())
  clientId     String       @map("client_id")
  billingModel BillingModel @map("billing_model")
  billingRate  Decimal      @db.Decimal(12, 2) @map("billing_rate")
  currency     String       @default("USD")
  effectiveFrom DateTime    @map("effective_from")
  effectiveTo  DateTime?    @map("effective_to")
  slaPenaltyPercentage Decimal @default(0.0) @db.Decimal(5, 2) @map("sla_penalty_percentage")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([effectiveFrom, effectiveTo])
  @@map("contract_terms")
}

model SlaPolicy {
  id                   String         @id @default(uuid())
  clientId             String         @unique @map("client_id")
  defaultTargetDays    Int            @default(14) @map("default_target_days")
  deadlinePolicy       DeadlinePolicy @default(WORKING_DAYS) @map("deadline_policy")
  businessHourStart    Int            @default(9) @map("business_hour_start")
  businessHourEnd      Int            @default(17) @map("business_hour_end")
  shortlistStageTarget PipelineStage  @default(SHORTLIST_SUBMITTED) @map("shortlist_stage_target")
  pauseOnHold          Boolean        @default(true) @map("pause_on_hold")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

model HolidayCalendar {
  id        String    @id @default(uuid())
  clientId  String    @unique @map("client_id")
  name      String
  year      Int       @default(2026)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  holidays  Holiday[]

  @@map("holiday_calendars")
}

model Holiday {
  id          String          @id @default(uuid())
  calendarId  String          @map("calendar_id")
  name        String
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")

  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId])
  @@map("holidays")
}

model RecruitmentRole {
  id                     String         @id @default(uuid())
  clientId               String         @map("client_id")
  recruiterId            String?        @map("recruiter_id")
  managerId              String?        @map("manager_id")
  title                  String
  description            String?
  priority               String         @default("MEDIUM")
  status                 RoleStatus     @default(OPEN)
  currentStage           PipelineStage  @default(NEW_REQUEST) @map("current_stage")
  requestReceivedDate    DateTime       @default(now()) @map("request_received_date")
  slaStartDate           DateTime       @default(now()) @map("sla_start_date")
  slaDeadlineDate        DateTime       @map("sla_deadline_date")
  deadlinePolicy         DeadlinePolicy @default(WORKING_DAYS) @map("deadline_policy")
  shortlistSubmittedDate DateTime?      @map("shortlist_submitted_date")
  filledDate             DateTime?      @map("filled_date")
  isBreached             Boolean        @default(false) @map("is_breached")
  breachedAt             DateTime?      @map("breached_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recruiter              User?          @relation("RecruiterAssignedRoles", fields: [recruiterId], references: [id], onDelete: SetNull)
  manager                User?          @relation("ManagerAssignedRoles", fields: [managerId], references: [id], onDelete: SetNull)
  stageHistories         RoleStageHistory[]
  timeEntries            TimeEntry[]
  billableHires          BillableHire[]
  alerts                 Alert[]
  slaExtensions          SlaExtension[]

  @@index([clientId])
  @@index([recruiterId])
  @@index([status])
  @@index([slaDeadlineDate])
  @@map("recruitment_roles")
}

model SlaExtension {
  id         String          @id @default(uuid())
  roleId     String          @map("role_id")
  reason     String
  addedDays  Int             @map("added_days")
  extendedBy String          @map("extended_by")
  createdAt  DateTime        @default(now()) @map("created_at")

  role       RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("sla_extensions")
}

model RoleStageHistory {
  id        String          @id @default(uuid())
  roleId    String          @map("role_id")
  fromStage PipelineStage?  @map("from_stage")
  toStage   PipelineStage   @map("to_stage")
  notes     String?
  changedBy String          @map("changed_by")
  createdAt DateTime        @default(now()) @map("created_at")

  role      RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("role_stage_histories")
}

model RecruiterCostProfile {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  costType            RecruiterCostType @default(HOURLY) @map("cost_type")
  hourlyCostRate      Decimal?          @db.Decimal(10, 2) @map("hourly_cost_rate")
  monthlySalary       Decimal?          @db.Decimal(12, 2) @map("monthly_salary")
  standardWeeklyHours Decimal           @default(40.0) @db.Decimal(5, 2) @map("standard_weekly_hours")
  overheadMultiplier  Decimal           @default(0.0) @db.Decimal(5, 2) @map("overhead_multiplier")
  effectiveFrom       DateTime          @map("effective_from")
  effectiveTo         DateTime?         @map("effective_to")
  createdAt           DateTime          @default(now()) @map("created_at")

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([effectiveFrom, effectiveTo])
  @@map("recruiter_cost_profiles")
}

model TimeEntry {
  id             String          @id @default(uuid())
  recruiterId    String          @map("recruiter_id")
  clientId       String          @map("client_id")
  roleId         String?         @map("role_id")
  taskType       String          @map("task_type")
  workDate       DateTime        @db.Date @map("work_date")
  hours          Decimal         @db.Decimal(5, 2)
  isBillable     Boolean         @default(true) @map("is_billable")
  description    String?
  status         TimeEntryStatus @default(SUBMITTED)
  reviewedById   String?         @map("reviewed_by_id")
  reviewedAt     DateTime?       @map("reviewed_at")
  rejectionReason String?        @map("rejection_reason")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  recruiter      User            @relation("RecruiterEntries", fields: [recruiterId], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("ReviewedEntries", fields: [reviewedById], references: [id], onDelete: SetNull)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role           RecruitmentRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  adjustments    TimeEntryAdjustment[]

  @@index([recruiterId])
  @@index([clientId])
  @@index([workDate])
  @@index([status])
  @@map("time_entries")
}

model TimeEntryAdjustment {
  id             String    @id @default(uuid())
  timeEntryId    String    @map("time_entry_id")
  adjustedHours  Decimal   @db.Decimal(5, 2) @map("adjusted_hours")
  reason         String
  adjustedBy     String    @map("adjusted_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  timeEntry      TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
  @@map("time_entry_adjustments")
}

model Invoice {
  id             String      @id @default(uuid())
  clientId       String      @map("client_id")
  invoiceNumber  String      @unique @map("invoice_number")
  periodStart    DateTime    @map("period_start")
  periodEnd      DateTime    @map("period_end")
  amount         Decimal     @db.Decimal(12, 2)
  currency       String      @default("USD")
  status         String      @default("ISSUED")
  issuedDate     DateTime    @default(now()) @map("issued_date")
  paidDate       DateTime?   @map("paid_date")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems      InvoiceLineItem[]

  @@index([clientId])
  @@index([periodStart, periodEnd])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @default(1.0) @db.Decimal(8, 2)
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model BillableHire {
  id        String          @id @default(uuid())
  clientId  String          @map("client_id")
  roleId    String          @map("role_id")
  candidateName String      @map("candidate_name")
  hireDate  DateTime        @map("hire_date")
  feeAmount Decimal         @db.Decimal(12, 2) @map("fee_amount")
  currency  String          @default("USD")
  createdAt DateTime        @default(now()) @map("created_at")

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([roleId])
  @@index([hireDate])
  @@map("billable_hires")
}

model FinancialAdjustment {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  date        DateTime @default(now())
  approvedBy  String   @map("approved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
  @@map("financial_adjustments")
}

model Alert {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  type             AlertType
  severity         AlertSeverity @default(WARNING)
  clientId         String?       @map("client_id")
  roleId           String?       @map("role_id")
  recruiterId      String?       @map("recruiter_id")
  triggerRule      String        @map("trigger_rule")
  thresholdValue   Decimal?      @db.Decimal(10, 2) @map("threshold_value")
  actualValue      Decimal?      @db.Decimal(10, 2) @map("actual_value")
  message          String
  status           AlertStatus   @default(OPEN)
  deduplicationKey String        @unique @map("deduplication_key")
  detectedAt       DateTime      @default(now()) @map("detected_at")
  resolvedAt       DateTime?     @map("resolved_at")
  resolvedById     String?       @map("resolved_by_id")
  resolutionNotes  String?       @map("resolution_notes")
  lastNotificationAttempt DateTime? @map("last_notification_attempt")
  notificationStatus      String?   @map("notification_status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client           Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role             RecruitmentRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resolvedBy       User?         @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  deliveryLogs     AlertDeliveryLog[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([detectedAt])
  @@map("alerts")
}

model AlertDeliveryLog {
  id        String   @id @default(uuid())
  alertId   String   @map("alert_id")
  channel   String
  status    String
  attempt   Int      @default(1)
  error     String?
  sentAt    DateTime @default(now()) @map("sent_at")

  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("alert_delivery_logs")
}

model ImportJob {
  id           String            @id @default(uuid())
  entityType   String            @map("entity_type")
  filename     String
  totalRows    Int               @default(0) @map("total_rows")
  importedRows Int               @default(0) @map("imported_rows")
  failedRows   Int               @default(0) @map("failed_rows")
  status       String            @default("COMPLETED")
  performedBy  String            @map("performed_by")
  createdAt    DateTime          @default(now()) @map("created_at")

  errors       ImportRowError[]

  @@map("import_jobs")
}

model ImportRowError {
  id        String    @id @default(uuid())
  jobId     String    @map("job_id")
  rowNumber Int       @map("row_number")
  field     String?
  message   String
  rawData   String?   @map("raw_data")

  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_row_errors")
}

model SystemSetting {
  id                     String       @id @default(uuid())
  organizationId         String       @map("organization_id")
  key                    String
  value                  String
  updatedAt              DateTime     @updatedAt @map("updated_at")

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  details        String?
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WeeklyReport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  summaryJson    String   @map("summary_json")
  sentToEmails   String?  @map("sent_to_emails")
  status         String   @default("GENERATED")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("weekly_reports")
}

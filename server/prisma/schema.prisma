datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  systemSettings SystemSetting[]
  auditLogs      AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  passwordHash   String
  name           String
  role           String       @default("RECRUITER") // OWNER, MANAGER, RECRUITER, FINANCE
  isActive       Boolean      @default(true)
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    UserClientAssignment[]
  timeEntries    TimeEntry[]  @relation("RecruiterEntries")
  reviewedEntries TimeEntry[] @relation("ReviewedEntries")
  costProfiles   RecruiterCostProfile[]
  assignedRoles  RecruitmentRole[] @relation("RecruiterAssignedRoles")
  managedRoles   RecruitmentRole[] @relation("ManagerAssignedRoles")
  resolvedAlerts Alert[]      @relation("AlertResolvedBy")
  auditLogs      AuditLog[]
}

model Client {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String         @unique
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  billingModel   String         @default("RETAINER") // RETAINER, HOURLY, PER_HIRE
  currency       String         @default("USD")
  timeZone       String         @default("America/New_York")
  marginWarningThreshold Float  @default(20.0) // warning if profit margin is below this %
  deadlinePolicy String         @default("WORKING_DAYS") // WORKING_DAYS, CALENDAR_DAYS
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    UserClientAssignment[]
  contractTerms  ContractTerm[]
  slaPolicy      SlaPolicy?
  holidayCalendar HolidayCalendar?
  roles          RecruitmentRole[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  billableHires  BillableHire[]
  adjustments    FinancialAdjustment[]
  alerts         Alert[]
}

model UserClientAssignment {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
}

model ContractTerm {
  id           String       @id @default(uuid())
  clientId     String
  billingModel String       // RETAINER, HOURLY, PER_HIRE
  billingRate  Float        // Hourly rate, monthly retainer, or per-hire fee
  currency     String       @default("USD")
  effectiveFrom DateTime
  effectiveTo  DateTime?
  slaPenaltyPercentage Float @default(0.0) // contractual penalty % on fee if SLA breached
  notes        String?
  createdAt    DateTime     @default(now())

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SlaPolicy {
  id                   String         @id @default(uuid())
  clientId             String         @unique
  defaultTargetDays    Int            @default(14)
  deadlinePolicy       String         @default("WORKING_DAYS") // WORKING_DAYS, CALENDAR_DAYS
  businessHourStart    Int            @default(9)  // 09:00
  businessHourEnd      Int            @default(17) // 17:00
  shortlistStageTarget String         @default("SHORTLIST_SUBMITTED")
  pauseOnHold          Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model HolidayCalendar {
  id        String    @id @default(uuid())
  clientId  String    @unique
  name      String
  year      Int       @default(2026)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  holidays  Holiday[]
}

model Holiday {
  id          String          @id @default(uuid())
  calendarId  String
  name        String
  date        DateTime
  createdAt   DateTime        @default(now())

  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
}

model RecruitmentRole {
  id                     String         @id @default(uuid())
  clientId               String
  recruiterId            String?
  managerId              String?
  title                  String
  description            String?
  priority               String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status                 String         @default("OPEN") // OPEN, ON_HOLD, FILLED, CANCELLED
  currentStage           String         @default("NEW_REQUEST")
  requestReceivedDate    DateTime       @default(now())
  slaStartDate           DateTime       @default(now())
  slaDeadlineDate        DateTime
  deadlinePolicy         String         @default("WORKING_DAYS") // WORKING_DAYS, CALENDAR_DAYS
  shortlistSubmittedDate DateTime?
  filledDate             DateTime?
  isBreached             Boolean        @default(false)
  breachedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recruiter              User?          @relation("RecruiterAssignedRoles", fields: [recruiterId], references: [id], onDelete: SetNull)
  manager                User?          @relation("ManagerAssignedRoles", fields: [managerId], references: [id], onDelete: SetNull)
  stageHistories         RoleStageHistory[]
  timeEntries            TimeEntry[]
  billableHires          BillableHire[]
  alerts                 Alert[]
  slaExtensions          SlaExtension[]
}

model SlaExtension {
  id         String          @id @default(uuid())
  roleId     String
  reason     String
  addedDays  Int
  extendedBy String
  createdAt  DateTime        @default(now())

  role       RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model RoleStageHistory {
  id        String          @id @default(uuid())
  roleId    String
  fromStage String?
  toStage   String
  notes     String?
  changedBy String          // User ID or System
  createdAt DateTime        @default(now())

  role      RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model RecruiterCostProfile {
  id                  String            @id @default(uuid())
  userId              String
  costType            String            @default("HOURLY") // HOURLY, SALARIED
  hourlyCostRate      Float?            // if HOURLY
  monthlySalary       Float?            // if SALARIED
  standardWeeklyHours Float             @default(40.0)
  overheadMultiplier  Float             @default(0.0) // e.g. 0.15 for 15% employer burden
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  createdAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id             String          @id @default(uuid())
  recruiterId    String
  clientId       String
  roleId         String?
  taskType       String          // SOURCING, SCREENING, CANDIDATE_CALL, INTERVIEW, CLIENT_MEETING, COORDINATION, REPORTING, OTHER
  workDate       DateTime
  hours          Float
  isBillable     Boolean         @default(true)
  description    String?
  status         String          @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  recruiter      User            @relation("RecruiterEntries", fields: [recruiterId], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("ReviewedEntries", fields: [reviewedById], references: [id], onDelete: SetNull)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role           RecruitmentRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  adjustments    TimeEntryAdjustment[]
}

model TimeEntryAdjustment {
  id             String    @id @default(uuid())
  timeEntryId    String
  adjustedHours  Float
  reason         String
  adjustedBy     String
  createdAt      DateTime  @default(now())

  timeEntry      TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String      @id @default(uuid())
  clientId       String
  invoiceNumber  String      @unique
  periodStart    DateTime
  periodEnd      DateTime
  amount         Float
  currency       String      @default("USD")
  status         String      @default("ISSUED") // ISSUED, PAID, VOID
  issuedDate     DateTime    @default(now())
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems      InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1.0)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model BillableHire {
  id        String          @id @default(uuid())
  clientId  String
  roleId    String
  candidateName String
  hireDate  DateTime
  feeAmount Float
  currency  String          @default("USD")
  createdAt DateTime        @default(now())

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      RecruitmentRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model FinancialAdjustment {
  id          String   @id @default(uuid())
  clientId    String
  amount      Float    // Positive for credit/adjustment revenue, negative for penalty/deduction
  reason      String
  date        DateTime @default(now())
  approvedBy  String
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Alert {
  id               String        @id @default(uuid())
  organizationId   String
  type             String        // AMBER_SLA, RED_SLA, LOW_MARGIN, RECRUITER_OVERLOAD
  severity         String        @default("WARNING") // INFO, WARNING, CRITICAL
  clientId         String?
  roleId           String?
  recruiterId      String?
  triggerRule      String
  thresholdValue   Float?
  actualValue      Float?
  message          String
  status           String        @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  deduplicationKey String        @unique
  detectedAt       DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNotes  String?
  lastNotificationAttempt DateTime?
  notificationStatus      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client           Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role             RecruitmentRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resolvedBy       User?         @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  deliveryLogs     AlertDeliveryLog[]
}

model AlertDeliveryLog {
  id        String   @id @default(uuid())
  alertId   String
  channel   String   // EMAIL, SLACK, IN_APP
  status    String   // DELIVERED, FAILED
  attempt   Int      @default(1)
  error     String?
  sentAt    DateTime @default(now())

  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id           String            @id @default(uuid())
  entityType   String            // CLIENTS, RECRUITERS, ROLES, TIME_ENTRIES, BILLING
  filename     String
  totalRows    Int               @default(0)
  importedRows Int               @default(0)
  failedRows   Int               @default(0)
  status       String            @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  performedBy  String
  createdAt    DateTime          @default(now())

  errors       ImportRowError[]
}

model ImportRowError {
  id        String    @id @default(uuid())
  jobId     String
  rowNumber Int
  field     String?
  message   String
  rawData   String?

  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id                     String       @id @default(uuid())
  organizationId         String
  key                    String
  value                  String
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // USER_LOGIN, TIME_ENTRY_APPROVED, RATE_CHANGED, etc.
  entityType     String
  entityId       String
  details        String?      // JSON or text
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WeeklyReport {
  id             String   @id @default(uuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  summaryJson    String
  sentToEmails   String?
  status         String   @default("GENERATED")
  sentAt         DateTime?
  createdAt      DateTime @default(now())
}

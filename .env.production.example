# =================================================================
# AGENCY SLA AND MARGIN LEAKAGE TRACKER - PRODUCTION CONFIGURATION
# =================================================================
# IMPORTANT: Provide actual values via secret manager (AWS SSM, GCP Secret Manager, Vault)
# Do NOT check actual production secrets into git.

NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (SSL mode require for cloud instances like AWS RDS / GCP Cloud SQL)
DATABASE_URL=postgresql://agency_admin:REPLACE_WITH_STRONG_PASSWORD@postgres.internal.agency.com:5432/agency_tracker_db?schema=public&sslmode=require

# Authentication & Security
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://app.agencytracker.com

# External Integrations
# Slack Webhook URL for SLA breaches, margin warnings, and recruiter overload alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK

# SMTP Configuration for alert dispatch and weekly summaries
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=alerts@agencytracker.com

# Logging & Observability
LOG_LEVEL=info
